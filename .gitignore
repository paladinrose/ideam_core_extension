# --- Godot-cpp ---
# We don't track the library itself, just the code we write.
godot-cpp/
godot-project/
executable/

# --- Build Artifacts ---
# These are generated by SCons/Compilers. They are huge and change every build.
bin/
gen/
obj/
*.obj
*.o
*.a
*.lib
*.so
*.dll
*.dylib
*.exp
*.pdb

# --- SCons Internal ---
# This tracks your build state locally; it shouldn't go to GitHub.
.sconsign.dblite
.sconf_temp/

# --- Editor & OS Junk ---
.vscode/
.DS_Store
Thumbs.db
*.swp